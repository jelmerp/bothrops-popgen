process {
    withName: '.*:FREEBAYES' {
        // --genotype-qualities is required: without it FreeBayes emits no FORMAT/GQ,
        // and the downstream 'FORMAT/GQ < 20' genotype filter silently does nothing.
        // NOTE: this ext.args REPLACES Sarek's own FreeBayes defaults
        // ('--min-alternate-fraction 0.1 --min-mapping-quality 1').
        ext.args = '--report-monomorphic --genotype-qualities'
    }
    withName: '.*GENOTYPEGVCFS' {
        ext.args = '-all-sites'
    }

    resourceLimits = [
        time: 8.h
    ]
}
